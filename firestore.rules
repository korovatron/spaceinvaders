rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow get: if false;
      allow list: if request.query.limit <= 50;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'wave', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 10
        && request.resource.data.name.matches('^[A-Za-z0-9 _-]+$')
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 500000
        && request.resource.data.wave is int
        && request.resource.data.wave >= 1 && request.resource.data.wave <= 99
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
